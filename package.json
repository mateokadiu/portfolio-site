{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio — bento-grid interactive showcase.",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/fetch-github-activity.mjs && node scripts/generate-icons.mjs",
    "build": "astro build",
    "preview": "node tests/serve.mjs dist",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "./scripts/visual.sh",
    "test:visual:update": "./scripts/visual.sh --update-snapshots",
    "test:lighthouse": "lhci autorun",
    "test:live": "playwright test -c playwright.live.config.ts",
    "screenshots:readme": "PW_README=1 playwright test --project=readme",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:visual && pnpm test:lighthouse"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/react": "^4.2.4",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.7.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.12.1",
    "typescript": "^5.7.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "fast-check": "^4.10.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "vitest": "^2.1.8"
  }
}
