---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '~/components/Footer.astro';
import Nav from '~/components/Nav.astro';
import { SITE, SOCIAL, siteUrl } from '~/lib/data';
import { type JsonLdNode, buildPersonNode, websiteNode } from '~/lib/seo';

interface Props {
  /** Page title. The author's name is appended unless the title already contains it. */
  title?: string;
  description?: string;
  ogImage?: string;
  /** Defaults to the current page's URL. */
  canonical?: string;
  pageType?: 'website' | 'profile';
  /** Page-level JSON-LD nodes; the site-wide Person + WebSite are always included. */
  jsonLd?: JsonLdNode[];
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/og/default.png',
  canonical = siteUrl(Astro.url.pathname),
  pageType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE.author) ? title : `${title} — ${SITE.author}`;
const absoluteOg = new URL(ogImage, SITE.url).toString();
const [firstName, ...lastNames] = SITE.author.split(' ');

const graph = {
  '@context': 'https://schema.org',
  '@graph': [websiteNode, await buildPersonNode(), ...jsonLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#252525" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="gxH_Zu8T9GiJLNEBvVIrNK2blZP78v0v0BEdrSUBkXM" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href={SOCIAL.github} />
    <link rel="me" href={SOCIAL.linkedin} />
    <link rel="author" href={siteUrl('/about')} />

    <link
      rel="preload"
      href="/fonts/Geist-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/GeistMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/GeistMono-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${fullTitle} — preview card`} />
    {pageType === 'profile' && <meta property="profile:first_name" content={firstName} />}
    {pageType === 'profile' && <meta property="profile:last_name" content={lastNames.join(' ')} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <meta name="twitter:image:alt" content={`${fullTitle} — preview card`} />

    <ClientRouter />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-background"
      >skip to content</a
    >
    <Nav />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      // ClientRouter doesn't re-fire the browser's default fragment scroll on
      // cross-page navigations. After each page-load, if a hash is present,
      // smooth-scroll to it.
      function scrollToHash() {
        if (!window.location.hash) return;
        const id = window.location.hash.slice(1);
        const el = document.getElementById(id);
        if (el) {
          requestAnimationFrame(() => {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
      }
      scrollToHash();
      document.addEventListener('astro:page-load', scrollToHash);
    </script>
  </body>
</html>
