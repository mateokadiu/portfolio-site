---
import { SITE } from '~/lib/data';

// Per-character reveal, rendered at build time and animated in CSS: no JS, and
// no flash from hiding server-rendered text during hydration. Words stay
// unbreakable units so the name still wraps between words on narrow screens.
let charIndex = 0;
const words = SITE.author.split(' ').map((word) => [...word].map((ch) => ({ ch, i: charIndex++ })));
---

<section
  class="relative mx-auto flex min-h-[78vh] max-w-6xl flex-col justify-center px-6 pb-12 pt-20 sm:pt-28"
>
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">
    {SITE.city.toLowerCase()}, {SITE.countryCode.toLowerCase()} · {SITE.jobTitle.toLowerCase()}
  </p>
  <h1
    class="mt-4 overflow-hidden font-display text-[clamp(3rem,9vw,8.5rem)] font-semibold leading-[0.95] tracking-tight text-foreground"
  >
    <span class="sr-only">{SITE.author}</span>
    <span aria-hidden="true">
      {
        words.map((chars, w) => (
          <>
            {w > 0 && ' '}
            <span class="inline-block whitespace-nowrap">
              {chars.map(({ ch, i }) => (
                <span class="hero-char" style={`--i: ${i}`}>
                  {ch}
                </span>
              ))}
            </span>
          </>
        ))
      }
    </span>
  </h1>
  <p class="hero-tagline mt-6 max-w-2xl text-balance text-base leading-relaxed text-muted sm:text-lg">
    Every tile below is a project I shipped. Click in for an interactive demo of how it works.
  </p>

  <slot />

  <div
    class="hero-cue mt-14 flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-muted"
    aria-hidden="true"
  >
    <span>scroll</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 4v16m0 0l-6-6m6 6l6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>

<style>
  .hero-char {
    display: inline-block;
    animation: hero-rise 0.9s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 25ms);
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(110%);
    }
  }
  .hero-tagline {
    --enter-y: 14px;
    animation: enter 0.7s var(--ease-out-expo) 0.45s both;
  }
  .hero-cue {
    --enter-y: 8px;
    animation:
      enter 0.5s var(--ease-out-expo) 0.7s both,
      hero-bob 1.4s ease-in-out 1.2s infinite alternate;
  }
  @keyframes hero-bob {
    to {
      transform: translateY(6px);
    }
  }
</style>
