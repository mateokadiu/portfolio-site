---
import ProjectDemo from '~/components/ProjectDemo.astro';
import Tile from '~/components/Tile.astro';
import TileHeader from '~/components/TileHeader.astro';
import { sitePath } from '~/lib/data';
import type { Project } from '~/lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<Tile
  size={project.tileSize}
  href={sitePath(`/projects/${project.slug}`)}
  label={`${project.name} — ${project.tagline}`}
  transitionName={`project-${project.slug}`}
>
  <TileHeader
    name={project.name}
    tagline={project.tagline}
    status={project.status}
    isPrivate={project.isPrivate}
  />
  <!-- Translators must not rewrite React-managed DOM (hydration mismatch, stale text). -->
  <div class="mt-4 flex flex-1 flex-col" translate="no">
    <ProjectDemo slug={project.slug} hydrate="visible" />
  </div>
</Tile>
