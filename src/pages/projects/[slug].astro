---
import { getCollection, render } from 'astro:content';
import CodeBlock from '~/components/mdx/CodeBlock.astro';
import InlineCode from '~/components/mdx/InlineCode.astro';
import ProjectDemo from '~/components/ProjectDemo.astro';
import Layout from '~/layouts/Layout.astro';
import { sitePath, siteUrl } from '~/lib/data';
import { getProjects, type ProjectEntry } from '~/lib/projects';
import { breadcrumbNode, type JsonLdNode, personRef, websiteRef } from '~/lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const slug = entry.id;
const { Content } = await render(entry);
const {
  name,
  tagline,
  seoTitle,
  description,
  language,
  status,
  stack,
  repoUrl,
  isPrivate,
  demoHint: hint,
} = entry.data;

const projectUrl = siteUrl(`/projects/${slug}`);
const ogImage = `/og/${slug}.png`;

const projectLd: JsonLdNode = {
  '@type': repoUrl ? 'SoftwareSourceCode' : 'CreativeWork',
  '@id': `${projectUrl}#project`,
  name,
  description,
  url: projectUrl,
  image: siteUrl(ogImage),
  author: personRef,
  isPartOf: websiteRef,
  keywords: stack.join(', '),
  ...(repoUrl && {
    codeRepository: repoUrl,
    programmingLanguage: language,
    // Every public repo ships under MIT (checked against the GitHub license API).
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
  }),
};

const breadcrumbLd = breadcrumbNode([
  { name: 'Home', path: '/' },
  { name: 'Projects', path: '/projects' },
  { name, path: `/projects/${slug}` },
]);

const moreProjects = (await getProjects()).filter((p) => p.slug !== slug);
---

<Layout title={seoTitle} description={description} ogImage={ogImage} jsonLd={[projectLd, breadcrumbLd]}>
  <article class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <a
      href="/#work"
      class="mb-6 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground sm:mb-8"
    >
      ← back to all projects
    </a>

    <header class="mb-8 sm:mb-10">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-[11px] uppercase tracking-wide text-muted sm:text-xs">
        <span class="rounded border border-border bg-card px-2 py-0.5">{status}</span>
        {isPrivate && <span class="rounded border border-accent/40 bg-accent/10 px-2 py-0.5 text-accent">🔒 private</span>}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener"
            class="rounded border border-border bg-card px-2 py-0.5 transition-colors hover:border-accent hover:text-accent"
          >
            github ↗
          </a>
        )}
      </div>
      <h1 class="break-words font-mono text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl" translate="no">{name}</h1>
      <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">{tagline}</p>
      <div class="mt-4 flex flex-wrap gap-1.5 sm:mt-5" translate="no">
        {stack.map((tech) => (
          <span class="rounded-md border border-border bg-card px-2 py-1 font-mono text-[11px] text-muted sm:text-xs">
            {tech}
          </span>
        ))}
      </div>
    </header>

    <aside class="mb-4 rounded-xl border border-accent/25 bg-accent/5 p-3 sm:p-4">
      <h2 class="mb-2 flex items-center gap-2 font-mono text-[11px] font-normal uppercase tracking-wider text-accent">
        <span aria-hidden="true">▸</span> try the demo
      </h2>
      <p class="mb-2 text-[14px] text-foreground sm:text-sm">{hint.headline}</p>
      <ol class="space-y-1.5 text-[13px] text-muted sm:text-sm">
        {hint.steps.map((s, i) => (
          <li class="flex gap-2 leading-relaxed">
            <span class="select-none font-mono text-accent">{i + 1}.</span>
            <span>{s}</span>
          </li>
        ))}
      </ol>
    </aside>

    <div
      class="mb-12 rounded-2xl border border-border bg-card"
      transition:name={`project-${slug}`}
    >
      <!-- Translators must not rewrite React-managed DOM (hydration mismatch, stale text). -->
      <div class="flex min-h-[420px] w-full flex-col p-4 sm:aspect-[16/10] sm:min-h-0 sm:p-6" translate="no">
        <ProjectDemo slug={slug} hydrate="idle" />
      </div>
    </div>

    <div class="prose-project">
      <Content components={{ pre: CodeBlock, code: InlineCode }} />
    </div>

    <nav aria-labelledby="more-projects" class="mt-16 border-t border-border/60 pt-10">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 id="more-projects" class="font-mono text-xl font-semibold tracking-tight">
          more projects<span class="text-accent">.</span>
        </h2>
        <a href="/projects/" class="font-mono text-xs text-muted transition-colors hover:text-foreground">
          all projects →
        </a>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {moreProjects.map((p) => (
          <li>
            <a
              href={sitePath(`/projects/${p.slug}`)}
              class="block h-full rounded-xl border border-border bg-card p-4 transition-colors hover:border-accent/40 hover:bg-card-hover"
            >
              <span class="block font-mono text-sm font-medium text-foreground" translate="no">{p.name}</span>
              <span class="mt-1 block text-xs leading-relaxed text-muted">{p.tagline}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</Layout>

<style is:global>
  .prose-project {
    color: rgb(212 212 216);
    line-height: 1.65;
    font-size: 15px;
  }
  @media (min-width: 640px) {
    .prose-project {
      font-size: 16px;
      line-height: 1.7;
    }
  }
  .prose-project h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .prose-project h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .prose-project p {
    margin-bottom: 1rem;
  }
  .prose-project ul,
  .prose-project ol {
    margin: 1rem 0 1rem 1.25rem;
    padding-left: 0.5rem;
  }
  .prose-project li {
    margin-bottom: 0.4rem;
    list-style: disc;
  }
  .prose-project ol li {
    list-style: decimal;
  }
  .prose-project a {
    color: oklch(0.75 0.18 35);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose-project code {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .prose-project pre {
    background: oklch(0.18 0 0);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.85rem;
  }
  .prose-project pre code {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .prose-project blockquote {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-accent);
    background: oklch(0.18 0 0);
    border-radius: 0 6px 6px 0;
    color: rgb(228 228 231);
    font-style: italic;
    line-height: 1.55;
  }
  .prose-project blockquote p {
    margin: 0;
  }
  .prose-project table {
    width: 100%;
    margin: 1.25rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose-project th,
  .prose-project td {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose-project th {
    background: var(--color-card);
    font-weight: 600;
    color: var(--color-foreground);
  }
  .prose-project hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  .prose-project strong {
    color: var(--color-foreground);
    font-weight: 600;
  }
</style>
