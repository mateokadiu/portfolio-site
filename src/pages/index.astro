---
import BentoGrid from '~/components/BentoGrid.astro';
import Hero from '~/components/Hero';
import ProjectTile from '~/components/ProjectTile.astro';
import Tile from '~/components/Tile.astro';
import Layout from '~/layouts/Layout.astro';
import { PROJECTS, SITE, siteUrl } from '~/lib/data';
import { personRef, websiteRef } from '~/lib/seo';
import AboutTile from '~/tiles/AboutTile.astro';
import ContactTile from '~/tiles/ContactTile.astro';
import GithubTile from '~/tiles/GithubTile.astro';
import NowTile from '~/tiles/NowTile.astro';

const homePageJsonLd = {
  '@type': 'WebPage',
  '@id': `${siteUrl('/')}#webpage`,
  url: siteUrl('/'),
  name: SITE.title,
  description: SITE.description,
  inLanguage: 'en-US',
  isPartOf: websiteRef,
  about: personRef,
  primaryImageOfPage: siteUrl('/og/default.png'),
};

const projectListJsonLd = {
  '@type': 'ItemList',
  name: `Projects by ${SITE.author}`,
  numberOfItems: PROJECTS.length,
  itemListElement: PROJECTS.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: siteUrl(`/projects/${p.slug}`),
    name: p.name,
  })),
};
---

<Layout jsonLd={[homePageJsonLd, projectListJsonLd]}>
  <Hero client:idle />

  <BentoGrid id="work">
    {PROJECTS.map((project) => <ProjectTile project={project} />)}

    <Tile size="1x1" href="/about/" label="About Mateo Kadiu"><AboutTile /></Tile>
    <Tile size="1x1"><NowTile /></Tile>
    <Tile size="1x1"><GithubTile /></Tile>
    <Tile size="1x1"><ContactTile /></Tile>
  </BentoGrid>
</Layout>
