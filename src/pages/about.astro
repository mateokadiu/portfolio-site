---
import RolesTimeline from '~/components/cv/RolesTimeline.astro';
import Layout from '~/layouts/Layout.astro';
import {
  type SkillCategory,
  categoryHue,
  categoryLabel,
  loadEducation,
  loadPersonal,
  loadRoles,
  loadSkills,
  proficiencyDots,
} from '~/lib/cv';
import { SITE, SOCIAL, siteUrl } from '~/lib/data';
import { breadcrumbNode, personRef, websiteRef } from '~/lib/seo';

const [personal, roles, skills, education] = await Promise.all([
  loadPersonal(),
  loadRoles(),
  loadSkills(),
  loadEducation(),
]);

const categories: SkillCategory[] = [
  'languages',
  'backend',
  'frontend',
  'mobile',
  'data',
  'infra',
  'tools',
];

const currentRole = roles.find((r) => r.endDate === null);
const skillGroups = categories
  .map((cat) => ({
    cat,
    inCat: skills
      .filter((s) => s.category === cat)
      .sort((a, b) => b.yearsUsing - a.yearsUsing || a.order - b.order),
  }))
  .filter((g) => g.inCat.length > 0);
// Last cell spans the leftover columns of the 3-column grid (literal classes for Tailwind).
const LG_SPAN: Record<number, string> = {
  0: 'lg:col-span-1',
  1: 'lg:col-span-3',
  2: 'lg:col-span-2',
};

const bioParagraphs = personal.bio
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

const title = `About ${SITE.author} — Experience, Skills & CV`;
const description = `${SITE.author}: ${SITE.jobTitle.toLowerCase()}${currentRole ? ` at ${currentRole.company}` : ''}, based in ${SITE.city}. Experience, skills, education and a downloadable CV.`;

const profilePageJsonLd = {
  '@type': 'ProfilePage',
  '@id': `${siteUrl('/about')}#webpage`,
  url: siteUrl('/about'),
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: websiteRef,
  about: personRef,
  mainEntity: personRef,
  primaryImageOfPage: siteUrl('/og/about.png'),
};

const breadcrumbJsonLd = breadcrumbNode([
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
]);
---

<Layout
  title={title}
  description={description}
  ogImage="/og/about.png"
  pageType="profile"
  jsonLd={[profilePageJsonLd, breadcrumbJsonLd]}
>
  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16">
    <header class="mb-14">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">
        about · {SITE.city}, {SITE.country} · {SITE.timezone}
        {
          personal.openToWork && (
            <span class="ml-2 text-accent">· open to work</span>
          )
        }
      </p>
      <h1
        class="mt-4 font-mono text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl"
      >
        {SITE.author}
      </h1>
      <p class="mt-3 max-w-2xl text-balance text-base text-muted sm:text-lg">
        {personal.headline}
      </p>
      <p class="mt-4 max-w-2xl text-balance text-sm text-foreground/80">
        {personal.tagline}
      </p>

      <div class="mt-6 flex flex-wrap gap-2 font-mono text-xs">
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-border bg-card px-3 py-1.5 text-muted transition-colors hover:border-accent/40 hover:text-foreground"
        >
          github ↗
        </a>
        <a
          href={SOCIAL.linkedin}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-border bg-card px-3 py-1.5 text-muted transition-colors hover:border-accent/40 hover:text-foreground"
        >
          linkedin ↗
        </a>
        <a
          href={`mailto:${SOCIAL.email}`}
          class="rounded-md border border-border bg-card px-3 py-1.5 text-muted transition-colors hover:border-accent/40 hover:text-foreground"
        >
          {SOCIAL.email} ↗
        </a>
        <a
          href={SITE.cvPath}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-accent/40 bg-accent/10 px-3 py-1.5 text-accent transition-colors hover:bg-accent/15"
        >
          cv.pdf ↗
        </a>
      </div>
    </header>

    {
      bioParagraphs.length > 0 && (
        <section class="mb-20" aria-labelledby="bio">
          <h2 id="bio" class="mb-5 font-mono text-xl font-semibold tracking-tight sm:text-2xl">
            bio<span class="text-accent">.</span>
          </h2>
          <div class="max-w-3xl space-y-4 text-[15px] leading-relaxed text-foreground/85">
            {bioParagraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      )
    }

    {/* EXPERIENCE — sticky-scroll timeline */}
    <section class="mb-20" aria-labelledby="experience">
      <header class="mb-8">
        <h2 id="experience" class="font-mono text-xl font-semibold tracking-tight sm:text-2xl">
          experience<span class="text-accent">.</span>
        </h2>
      </header>
      <RolesTimeline roles={roles} />
    </section>

    {/* SKILLS — typographic matrix, grouped by altitude */}
    <section class="mb-20" aria-labelledby="skills">
      <header class="mb-5 flex items-baseline justify-between">
        <h2 id="skills" class="font-mono text-xl font-semibold tracking-tight sm:text-2xl">
          skills<span class="text-accent">.</span>
        </h2>
        <p class="font-mono text-[11px] uppercase tracking-wider text-muted">
          {skills.length} tools
        </p>
      </header>

      <div
        class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          skillGroups.map(({ cat, inCat }, i) => {
            const hue = categoryHue(cat);
            const isLast = i === skillGroups.length - 1;
            return (
              <section
                class:list={[
                  'bg-card p-5',
                  isLast && skillGroups.length % 2 === 1 && 'sm:col-span-2',
                  isLast && LG_SPAN[skillGroups.length % 3],
                ]}
              >
                <div class="mb-3 flex items-baseline justify-between">
                  <h3
                    class="font-mono text-[11px] uppercase tracking-[0.18em]"
                    style={`color: oklch(0.78 0.12 ${hue});`}
                  >
                    {categoryLabel(cat)}
                  </h3>
                  <span class="font-mono text-[11px] text-muted">
                    {inCat.length}
                  </span>
                </div>
                <ul class="space-y-1.5 font-mono text-sm">
                  {inCat.map((s) => {
                    const dots = proficiencyDots(s.proficiency);
                    return (
                      <li class="flex items-center justify-between gap-3">
                        <span class="truncate text-foreground/90">
                          {s.name}
                        </span>
                        <span class="flex shrink-0 items-center gap-2">
                          <span class="text-[11px] tabular-nums text-muted">
                            {s.yearsUsing}y<span class="sr-only"> experience</span>
                          </span>
                          <span
                            class="skill-dots"
                            role="img"
                            aria-label={`${s.proficiency} proficiency`}
                            style={`--dots: ${dots}; --dot-color: oklch(0.7 0.16 ${hue});`}
                          />
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </section>
            );
          })
        }
      </div>
    </section>

    {/* EDUCATION */}
    {
      education.length > 0 && (
        <section class="mb-16">
          <header class="mb-6">
            <h2 class="font-mono text-xl font-semibold tracking-tight sm:text-2xl">
              education<span class="text-accent">.</span>
            </h2>
          </header>
          <ul class="space-y-4">
            {education.map((e) => (
              <li class="rounded-xl border border-border bg-card p-4">
                <p class="font-mono text-[11px] uppercase tracking-wider text-muted">
                  {e.startYear} — {e.endYear} · {e.location}
                </p>
                <h3 class="mt-1 font-mono text-base font-semibold text-foreground">
                  {e.degree} · <span class="text-muted">{e.school}</span>
                </h3>
                {e.notes && <p class="mt-2 text-sm text-muted">{e.notes}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

  </article>
</Layout>
